SECRET_KEY=change-me
SUPABASE_URL=https://your-project.supabase.co

# Supabase Dashboard > Settings > API Keys > "Publishable and secret API keys" tab.
# If that tab shows a "Create new API keys" button, your project is still on
# legacy keys only — click it to generate these first.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Only needed for streams a developer marks as RevenueCat-backed — the actual
# per-project key lives on the revenue_stream row, this is a fallback/default.
REVENUECAT_API_KEY=
